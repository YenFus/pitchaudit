# PitchAudit environment configuration.
# Local dev: copy to .env.local. Hosted: set these in your host's dashboard.
# Never commit real values.

# --- Audits ------------------------------------------------------------------
# Strongly recommended. Free key (25,000 audits/day), no billing needed:
# https://developers.google.com/speed/docs/insights/v5/get-started
# Without it Google rate-limits you almost immediately, speed and accessibility
# can't be measured, and grades are marked "provisional".
PSI_API_KEY=

# --- Rate limiting & cache (optional, recommended when hosted) -----------------
# Free database at https://upstash.com. Without it, limits and cache live in
# each serverless instance's memory and are not shared.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Running behind your own reverse proxy (self-hosting) ---------------------
# Forwarding headers can be forged, so they're ignored unless you opt in.
# Set to true ONLY if a proxy you control sets X-Forwarded-For / X-Real-IP.
# (Not needed on Vercel.) Otherwise all visitors share one rate-limit bucket.
TRUST_PROXY_HEADERS=

# --- Site (optional) ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DOMAIN=
# Where the "GitHub" links point. Defaults to the upstream repository.
NEXT_PUBLIC_REPO_URL=
