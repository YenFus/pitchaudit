# PitchAudit settings. Copy to .env.local if you need any of these.
# Everything is optional — it works out of the box if Google Chrome is installed.

# Path to Chrome/Chromium, if it isn't in the usual place.
CHROME_PATH=

# Fallback for computers without Chrome: Google's hosted PageSpeed Insights.
# Free key at https://developers.google.com/speed/docs/insights/v5/get-started
# Note: with this set, sites you audit are sent to Google when Chrome isn't available.
PSI_API_KEY=

# Extra hostnames allowed besides localhost (comma-separated), only if you
# deliberately serve PitchAudit under another name on a trusted network.
PITCHAUDIT_ALLOWED_HOSTS=
